rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ── PUBLIC RELEASE APKs & ASSETS (READ-ONLY) ────────────────────────────
    match /releases/{buildNumber}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // ── DEFAULT LOCKDOWN ────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
