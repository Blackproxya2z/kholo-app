rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── PUBLIC APP CONFIGURATION & REMOTE ANNOUNCEMENTS (READ-ONLY) ─────────
    // Used for dynamic OTA feature flags, release metadata, and emergency banners.
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // ── STRICT PRIVACY-FIRST USER ISOLATION (OPT-IN BACKUP ONLY) ────────────
    // Sensitive health data is stored locally by default.
    // If a user explicitly enables multi-device backup, strict UID isolation is enforced.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /sync_queue/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // ── DEFAULT LOCKDOWN ────────────────────────────────────────────────────
    // Disallow all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
